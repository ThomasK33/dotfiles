# PATH helpers — idempotent so re-sourcing won't duplicate entries.
# Defined in .zshenv so both .zshenv and .zshrc can use them.
path_prepend() { case ":$PATH:" in *":$1:"*) ;; *) export PATH="$1:$PATH" ;; esac; }
path_append()  { case ":$PATH:" in *":$1:"*) ;; *) export PATH="$PATH:$1" ;; esac; }

# Mise shims for non-interactive shells (IDEs, scripts, etc.)
path_prepend "$HOME/.local/share/mise/shims"
